# ==============================================================================
# LABSA | لَبسة — Environment Configuration Template
# Copy this file to `.env.local` for local development.
# NEVER commit real production secrets, passwords, or service role keys to source control.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Default Store Locale ("ar" for Arabic RTL default, "en" for English LTR)
NEXT_PUBLIC_DEFAULT_LOCALE="ar"

# ------------------------------------------------------------------------------
# 1. Server-Side Supabase Database Integration (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# In production (NODE_ENV=production), order creation, stock deduction, and coupon
# usage require an authoritative PostgreSQL database via Supabase.
# See migrations in `supabase/migrations/` for schema, RLS policies, and atomic RPCs.
#
# - SUPABASE_URL: Your Supabase project REST endpoint (e.g. https://your-project.supabase.co)
# - SUPABASE_SERVICE_ROLE_KEY: Private service_role key for server-only operations.
#   CAUTION: NEVER expose this key in NEXT_PUBLIC_* variables or client bundles.
# - NEXT_PUBLIC_SUPABASE_ANON_KEY: Optional public anon key for public catalog reads.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ------------------------------------------------------------------------------
# 2. Administrative Authentication & Session Security (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# In production (NODE_ENV=production), administrative access fails closed unless all
# three variables below are configured. Local demo access is strictly disabled.
# - ADMIN_EMAIL: Authorized store administrator email
# - ADMIN_PASSWORD: Strong administrative password (min 16 characters recommended)
# - ADMIN_SESSION_SECRET: Cryptographically random secret (min 32 characters) for HMAC session signing
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# ------------------------------------------------------------------------------
# 3. Order Lookup Secret (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Dedicated cryptographic secret (minimum 32 characters, high entropy) for generating
# enumeration-resistant HMAC-SHA256 order lookup hashes (OrderNumber + NormalizedMobile).
# IMPORTANT: Must be a dedicated secret distinct from ADMIN_SESSION_SECRET.
# If unset or under 32 characters in production, order creation and lookup fail closed.
ORDER_LOOKUP_SECRET=""

# ------------------------------------------------------------------------------
# 4. Reverse Proxy & Distributed Rate Limiting (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# In production, client IP addresses MUST be verified through a designated edge proxy.
# Client-supplied headers are NEVER blindly trusted.
# Supported providers:
# - "cloudflare": Reads CF-Connecting-IP (requires Authenticated Origin Pulls to prevent bypass)
# - "vercel": Reads x-real-ip; Vercel documents it as the client IP and overwrites X-Forwarded-For
# - "nginx": Reads X-Real-IP set by Nginx (proxy_set_header X-Real-IP $remote_addr;)
# - "aws_alb": Reads verified client IP from AWS Application Load Balancer
TRUSTED_PROXY_PROVIDER=""

# Rate limiting backend:
# - "database": (Recommended for multi-instance clusters) Uses Supabase PostgreSQL atomic RPC
#   to enforce shared limits across all server instances without separate Redis infrastructure.
# - "edge_delegated": Delegates rate limiting to host-level edge controls (e.g. Cloudflare WAF
#   Rate Limiting Rules or Vercel Edge Middleware / Firewall).
# Note: In-memory limiting ("local_memory") is strictly forbidden in production.
RATE_LIMIT_BACKEND="database"

# ------------------------------------------------------------------------------
# 5. Local Development Fallbacks (DEVELOPMENT ONLY — IGNORED IN PRODUCTION)
# ------------------------------------------------------------------------------
# When running locally (NODE_ENV !== 'production'), setting these to "true" allows
# running in offline portfolio demo mode without a live Supabase project.
# Both are strictly ignored in production environments.
ALLOW_LOCAL_DEMO_STORE="false"
ALLOW_LOCAL_DEMO_ADMIN="false"
NEXT_PUBLIC_DEMO_MODE="false"

# ------------------------------------------------------------------------------
# 6. Customer Support & WhatsApp Contact Channel
# ------------------------------------------------------------------------------
# Defaults to the project's placeholder phone (+20 100 000 0000 -> 201000000000).
# In production, set to your official registered Egyptian business WhatsApp number:
NEXT_PUBLIC_WHATSAPP_NUMBER="201000000000"
NEXT_PUBLIC_WHATSAPP_URL=""
